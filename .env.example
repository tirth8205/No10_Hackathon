# Copy to .env and fill in. Never commit .env.
# one of these, matching GC_LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM backend: openai | anthropic | offline (keyword stub, no key needed)
GC_LLM=openai
GC_OPENAI_MODEL=gpt-5.4          # or gpt-5.4-mini for speed
GC_MODEL=claude-opus-5-5         # used when GC_LLM=anthropic
GC_EFFORT=medium
GC_VOTES=3
GC_DOC_TTL_MIN=60
# Record/replay cache for demo safety: off | record | replay
GC_CACHE=off
GC_CACHE_DIR=demo/cache
GC_DB_PATH=gateway_check.sqlite3
