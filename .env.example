# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# LLM backend: anthropic (real API), offline (keyword stub, no key needed), replay (cached results only)
GC_LLM=anthropic
GC_MODEL=claude-opus-5-5
GC_EFFORT=medium
GC_VOTES=3
GC_DOC_TTL_MIN=60
# Record/replay cache for demo safety: off | record | replay
GC_CACHE=off
GC_CACHE_DIR=demo/cache
GC_DB_PATH=gateway_check.sqlite3
